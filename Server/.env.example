# Copy this file to .env and fill in your values
# Never commit .env to git

# Your API-Football key (from dashboard.api-football.com)
API_FOOTBALL_KEY=your_api_football_key_here

# A random secret string shared between the server and the app
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your_random_secret_here

# Port (Railway sets this automatically, leave as 3000 for local dev)
PORT=3000
